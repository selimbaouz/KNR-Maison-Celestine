{{ 'knr-reinsurance.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-reinsurance.js' | asset_url }}" defer="defer"></script>

<knr-reinsurance
  class="knr-reinsurance"
  style="
    --background-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --reinsurance-columns: {{ section.blocks.size }};
  "
>
  {%- if section.blocks.size > 0 -%}
    <div class="knr-reinsurance__inner page-width">
      <div class="knr-reinsurance__viewport" data-ref="viewport">
        <div class="knr-reinsurance__track">
          {%- for block in section.blocks -%}
            <article class="knr-reinsurance__item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <p class="knr-reinsurance__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="knr-reinsurance__text">{{ block.settings.text | escape | strip }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="knr-reinsurance__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="knr-reinsurance__dot{% if forloop.first %} knr-reinsurance__dot--active{% endif %}"
              data-ref="dot"
              aria-label="{{ block.settings.title | escape }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</knr-reinsurance>

{% schema %}
{
  "name": "t:sections.knr-reinsurance.name",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.knr.colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.knr.background.label",
      "default": "#DCD5C3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.knr.text.label",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.knr-reinsurance.blocks.item.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.knr.heading.label",
          "default": "t:sections.knr-reinsurance.blocks.item.settings.title.default"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.knr.text.label",
          "default": "t:sections.knr-reinsurance.blocks.item.settings.text.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.knr-reinsurance.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "t:sections.knr-reinsurance.blocks.item.settings.title.default",
            "text": "t:sections.knr-reinsurance.blocks.item.settings.text.default"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "t:sections.knr-reinsurance.presets.returns_title",
            "text": "t:sections.knr-reinsurance.presets.returns_text"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "t:sections.knr-reinsurance.presets.payment_title",
            "text": "t:sections.knr-reinsurance.presets.payment_text"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "t:sections.knr-reinsurance.presets.service_title",
            "text": "t:sections.knr-reinsurance.presets.service_text"
          }
        }
      ]
    }
  ]
}
{% endschema %}
