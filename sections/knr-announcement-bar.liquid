{{ 'knr-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- if section.settings.text != blank -%}
  {%- if section.settings.link != blank -%}
    <a
      class="knr-announcement-bar"
      href="{{ section.settings.link }}"
      style="
        --background-color: {{ section.settings.background_color }};
        --text-color: {{ section.settings.text_color }};
      "
    >
      <p class="knr-announcement-bar__message">
        {{ section.settings.text }}
      </p>
    </a>
  {%- else -%}
    <div
      class="knr-announcement-bar"
      style="
        --background-color: {{ section.settings.background_color }};
        --text-color: {{ section.settings.text_color }};
      "
    >
      <p class="knr-announcement-bar__message">
        {{ section.settings.text }}
      </p>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.knr-announcement-bar.name",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.knr.text.label",
      "default": "t:sections.knr-announcement-bar.settings.text.default"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.knr.link.label"
    },
    {
      "type": "header",
      "content": "t:sections.knr.colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.knr.background.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.knr.text.label",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:sections.knr-announcement-bar.name"
    }
  ]
}
{% endschema %}
